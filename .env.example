# Copy this file to .env (not committed) and adjust it for your machine.
#   Windows : copy .env.example .env
#   Linux   : cp .env.example .env
#
# Relative paths are resolved from the project root.
# Absolute paths are accepted too, in either form:
#   Windows : DATABASE=C:/Users/me/data/paris.sqlite   (forward slashes recommended)
#   Linux   : DATABASE=/home/me/data/paris.sqlite

# Raw inputs read by ingestion/build_database.py
DVF_FILE=ingestion/ValeursFoncieres-2025.txt.gz
AIRBNB_FILE=ingestion/listing.csv.gz

# SQLite database written by ingestion, read by visualisation scripts
DATABASE=ingestion/paris.sqlite

# Folder where visualisation scripts save their PNG charts
OUTPUT_DIR=visualisation

# Force UTF-8 on Windows (accents in arrondissement names and DVF data); harmless on Linux.
PYTHONUTF8=1
